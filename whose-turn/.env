# Committed on purpose — nothing here is a secret. Secrets go in .env.local,
# which is gitignored. Vercel reads this file from the repo at build time.

# The canonical origin, used to build the ABSOLUTE URLs in index.html.
#
# Open Graph and Twitter crawlers reject relative image paths, so og:image and
# twitter:image have to be fully qualified. Vite substitutes %VITE_SITE_ORIGIN%
# into index.html at build time, so changing the domain is this one line — no
# hunting through the head for four copies of the old host.
#
# No trailing slash: the tags append their own paths.
VITE_SITE_ORIGIN=https://whose-turn-alpha.vercel.app
