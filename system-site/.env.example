# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed. Nothing in this file is needed for the drift check — that runs
# against the committed snapshot, with no Figma access at all.

# A Figma personal access token, scoped `file_variables:read`.
#
# ONLY used by:  npm --prefix system-site run figma:capture -- --rest
#
# That path needs the Variables REST API, which is Enterprise-only. This file is
# on a pro plan, so the endpoint returns 403 even with a valid token — the
# script says so and stops rather than writing a partial snapshot. Set this only
# if the plan is upgraded; otherwise use the --from-mcp path, which needs no
# credential.
FIGMA_TOKEN=
